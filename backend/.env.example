# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (admin panel dev server etc.). Use * to allow all.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://yesdhobi:yesdhobi@localhost:5432/yesdhobi?schema=public

# On AWS the container assembles DATABASE_URL from these instead (password comes from Secrets Manager):
# DB_HOST=  DB_PORT=5432  DB_NAME=yesdhobi  DB_USER=yesdhobi  DB_PASSWORD=
# SEED_ON_BOOT=true   # run the idempotent seed on container start

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Optional: enable "Continue with Google" for customers
GOOGLE_CLIENT_ID=

# ---- OTP / SMS ----
# When true every OTP is 1234 and is also returned in the API response (never enable in production).
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
# console | sns (AWS SNS) | msg91 | twilio   (console and sns are implemented; see src/services/sms.ts)
SMS_PROVIDER=console
SMS_SENDER_ID=YESDHB
# India (TRAI DLT) - required for real delivery to Indian numbers:
# SMS_DLT_ENTITY_ID=          # entity id registered on the DLT portal
# SMS_OTP_TEMPLATE_ID=        # approved template id for the OTP message
# MSG91_AUTH_KEY=             # if SMS_PROVIDER=msg91
# MSG91_OTP_TEMPLATE_ID=      # MSG91 flow/template id
# TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_FROM=   # if SMS_PROVIDER=twilio
# console | ses (AWS SES)
MAIL_PROVIDER=console
MAIL_FROM=Yes Dhobi <no-reply@yesdhobi.com>
# AWS_REGION=ap-south-1

# ---- Dispatch ----
# How long a pickup/delivery request stays offered to a rider before expiring
PICKUP_REQUEST_TTL_SECONDS=45
# Radius (km) used when offering requests to riders with a known location
DISPATCH_RADIUS_KM=8

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ---- Seed admin ----
SEED_ADMIN_EMAIL=admin@yesdhobi.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---- Object storage: AWS S3 (set automatically by infra/backend.yaml on AWS) ----
# When S3_BUCKET is set, uploads go here instead of ./uploads on disk.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
